{
  "name": "MyRemoveBG Codespace",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "runArgs": [
    "--device=/dev/net/tun"
  ],
  "containerEnv": {
    "DISABLE_JAVA_BUILD": "true"
  },
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "25",
      "installMaven": true,
      "installGradle": false
    },
    "ghcr.io/tailscale/codespace/tailscale": {
      "version": "latest"
    }
  }
}